{
  "expo": {
    "name": "CIIS",
    "slug": "ciis-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "ciis",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pk.gov.customs.ciis",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CIIS records your duty location so the control room can see your position while you are on duty.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "CIIS keeps sharing your duty location in the background so your route is recorded throughout your shift.",
        "UIBackgroundModes": [
          "location",
          "fetch"
        ]
      }
    },
    "android": {
      "package": "pk.gov.customs.ciis",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "FOREGROUND_SERVICE_MEDIA_PROJECTION",
        "READ_CALL_LOG",
        "PACKAGE_USAGE_STATS",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "CIIS keeps sharing your duty location in the background so your route is recorded throughout your shift.",
          "locationWhenInUsePermission": "CIIS records your duty location so the control room can see your position while you are on duty.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "0eac219b-2435-436a-b378-7b450e25067b"
      }
    }
  }
}
