# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app.

# Django backend base URL (defaults to the value in src/config.ts if unset)
EXPO_PUBLIC_API_BASE_URL=

# Optional map tile key. Leave empty to use free keyless CARTO tiles.
# EXPO_PUBLIC_MAP_KEY=

# Used only by scripts/start-tunnel.mjs
# BACKEND_PORT=8000
# NGROK_DOMAIN=
# NGROK=ngrok
